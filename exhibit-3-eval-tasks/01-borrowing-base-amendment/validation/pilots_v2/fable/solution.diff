+    # clause (g)
+    exclude_special_terms: bool
+    # Certificate presentation: ineligible categories in display order (one category per dollar)
+    ineligible_categories: Tuple[str, ...]
+    # Borrowing Base clause (b)
+    inventory_advance_rate: Decimal
+    nolv_advance_rate: Decimal
+    inventory_cap: Optional[Decimal]          # None: no dollar cap
+    # Reserves
+    dilution_reserve: bool
+    dilution_ratio_threshold: Decimal
+
